<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btnPolice"
        android:text="Call Police - 100"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnFire"
        android:text="Call Fire Service - 101"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAmbulance"
        android:text="Call Ambulance - 108"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnChildHelp"
        android:text="Call Child Helpline - 1098"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvPoliceStation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fetching nearest police station..."
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:textColor="#000000"
        android:layout_below="@id/cardMedicalInfo"
        />

    <ImageButton
        android:id="@+id/btnCallPolice"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/ic_baseline_circle_24"
        android:src="@drawable/ic_baseline_call_24"
        android:contentDescription="Call Police"
        android:layout_gravity="center"
        android:tint="@android:color/white"
        android:layout_marginBottom="24dp"
        android:layout_below="@id/tvPoliceStation"/>




</LinearLayout>
